{
	"name": "obsidian-agent",
	"version": "0.29.0",
	"description": "AI agent plugin for Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "npm-run-all --parallel dev:*",
		"dev:esbuild": "node esbuild.config.mjs",
		"dev:css": "node ./scripts/build-css.mjs --watch",
		"build": "npm-run-all --parallel build:*",
		"build:esbuild": "node scripts/verify-koffi-payloads.mjs && node scripts/verify-dsh-console-hide-patch.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/verify-dsh-console-hide-patch.mjs --bundle",
		"build:css": "node ./scripts/build-css.mjs --minify",
		"check:i18n": "node scripts/check-i18n.mjs",
		"verify:vault-rag": "node scripts/verify-vault-rag.mjs",
		"verify:dsh-console-hide": "node scripts/verify-dsh-console-hide-patch.mjs",
		"verify:bash-security": "node scripts/verify-koffi-payloads.mjs && node scripts/verify-dsh-console-hide-patch.mjs && node scripts/verify-bash-security.mjs",
		"verify:bash-session-temp": "node scripts/verify-bash-session-temp.mjs",
		"verify:powershell-execution": "node scripts/verify-powershell-execution.mjs",
		"verify:p4-network-routing": "node scripts/verify-p4-network-routing.mjs",
		"verify:bash-elevation": "node scripts/verify-bash-elevation.mjs",
		"verify:bash-runtime-fixtures": "node scripts/verify-bash-runtime-fixtures.mjs",
		"verify:agent-view-portals": "node scripts/verify-agent-view-portals.mjs",
		"verify:bash-approval-reviewer": "node scripts/verify-bash-approval-reviewer.mjs",
		"verify:bash-approval-mode-inheritance": "node scripts/verify-bash-approval-mode-inheritance.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"postinstall": "patch-package --error-on-fail"
	},
	"keywords": [],
	"author": "",
	"license": "AGPL-3.0",
	"devDependencies": {
		"@shadcn/ui": "^0.0.4",
		"@tailwindcss/container-queries": "^0.1.1",
		"@types/node": "^18.0.0",
		"@types/react": "^19.1.9",
		"@types/react-dom": "^19.1.7",
